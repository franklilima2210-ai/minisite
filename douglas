<title>Dr. Douglas Martins</title>
<style>
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;background:#080a11}
body{display:flex;justify-content:center;align-items:flex-start;overflow-x:hidden}
.site{position:relative;width:100%;max-width:349px;line-height:0;background:#080a11;overflow:hidden;isolation:isolate}
.layout-image{display:block;width:100%;height:auto;opacity:0}
.layer{position:absolute;inset:0;width:100%;height:100%;object-fit:fill;opacity:0;pointer-events:none;animation:reveal .9s cubic-bezier(.2,.7,.2,1) forwards}
.layer-1{clip-path:inset(0 0 78.5% 0);animation-delay:.05s}
.layer-2{clip-path:inset(21.5% 0 49% 0);animation-delay:.18s}
.layer-3{clip-path:inset(51% 0 35.4% 0);animation-delay:.31s}
.layer-4{clip-path:inset(64.6% 0 24.2% 0);animation-delay:.44s}
.layer-5{clip-path:inset(75.8% 0 0 0);animation-delay:.57s}
@keyframes reveal{from{opacity:0}to{opacity:1}}
.hotspot{position:absolute;display:block;z-index:5;border-radius:1px;background:transparent;outline-offset:2px;transition:background-color .25s ease,box-shadow .25s ease}
.hotspot:focus-visible{outline:2px solid #e8c48c}
.hotspot:hover{background:rgba(232,196,140,.10);box-shadow:0 0 0 1px rgba(232,196,140,.35)}
.site-link{left:15.19%;top:22.17%;width:67.91%;height:1.52%}
.more-one{left:10.03%;top:31.74%;width:29.23%;height:.88%}
.more-two{left:60.74%;top:38.82%;width:29.23%;height:.88%}
.more-three{left:10.03%;top:45.85%;width:29.23%;height:.88%}
.contact{left:28.94%;top:75.63%;width:41%;height:1.18%}
@media(prefers-reduced-motion:reduce){.layer{animation:none;opacity:1}.hotspot{transition:none}}
</style>
</head>
<body>
<main class="site" aria-label="Mini site do Dr. Douglas Martins">
